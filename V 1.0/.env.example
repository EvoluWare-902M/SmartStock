# ===== Configuración de SmartStock =====
# Copia este archivo como .env y ajusta los valores a tu equipo.
# En Render estos mismos nombres se capturan en "Environment Variables".

PORT=3000

# ----- Conexión a MySQL -----
# En tu computadora (XAMPP usa root sin contraseña por defecto):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartstock

# En la nube (Aiven) cambia los cinco valores de arriba por los de
# "Connection information" (usuario avnadmin, puerto distinto a 3306) y activa SSL:
DB_SSL=false
DB_SSL_CA=database/ca.pem

# Cambia esta clave por una cadena larga y aleatoria
JWT_SECRET=cambia-esta-clave-secreta
JWT_EXPIRES=8h

# Token que usará el microcontrolador (ESP32) para consultar el LED
IOT_TOKEN=smartstock-iot-demo

# ----- Asistente con modelo de lenguaje (OPCIONAL) -----
# Sin esta clave el asistente funciona en modo local, sin internet y sin costo.
# Con una clave de la API de Claude (https://platform.claude.com), las preguntas se
# responden con un modelo de lenguaje. Es un servicio de pago y envía un resumen del
# inventario de la sucursal a ese servicio.
ANTHROPIC_API_KEY=
ASISTENTE_MODELO=claude-haiku-4-5-20251001
